# Google Drive backup - configurazione di build
#
# Crea un OAuth Client ID di tipo "Desktop app" in Google Cloud.
VITE_GOOGLE_DRIVE_CLIENT_ID=

# Alcuni client Desktop Google richiedono anche il client secret nello scambio token.
# Lascia vuoto se Google non lo mostra o non lo richiede. Non committare mai valori reali.
VITE_GOOGLE_DRIVE_CLIENT_SECRET=

# Scope previsto per salvare solo file creati/gestiti dal gestionale.
VITE_GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
